; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Metal RT C13 Editor HG0"
run/main_scene="res://fixtures/e0_hg0.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=64
window/size/viewport_height=64
window/size/window_width_override=640
window/size/window_height_override=640
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method.mobile="forward_plus"
pathtracer/use_shader_execution_reordering=false
